  "devDependencies": {
    "@types/node": "^18.8.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.57.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "aws-classify-common": "0.2.0",
    "axios": "^1.20.0",
    "jose": "^5.10.0",
    "js-freeze-dry": "^1.1.4",
    "oidc-client-ts": "^3.5.0"
  }

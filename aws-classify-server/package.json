{
  "name": "aws-classify-server",
  "version": "0.2.0",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "files": [
    "/lib",
    "yml"
  ],
  "description": "Typescript Interface to Lambda and Websockets",
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selsamman/aws-classify.git",
    "directory": "aws-classify-server"
  },
  "author": "Sam Elsamman",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.103",
    "@types/node": "^18.8.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.57.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "aws-classify-common": "0.2.0",
    "js-freeze-dry": "^1.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

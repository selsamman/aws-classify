{
  "name": "@aws-classify-tests/server",
  "version": "0.1.0",
  "description": "Server portion of aws-classify",
  "main": "index.js",
  "scripts": {
    "test": "npm test --workspace @aws-classify-tests/client",
    "test:harness": "node --test offline.test.js aws-test.test.js auth-config.test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "debug": "node offline.js --debug",
    "start": "node offline.js",
    "prestart": "npm --prefix ../.. run build",
    "predebug": "npm --prefix ../.. run build",
    "test:aws": "node aws-test.js"
  },
  "files": [
    "lib",
    "yml"
  ],
  "author": "Sam Elsamman",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.103",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "dynalite": "^4.0.0",
    "eslint": "^8.57.1",
    "playwright-core": "^1.63.0",
    "serverless": "^4.43.0",
    "serverless-offline": "^14.8.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-classify-tests/requests": "0.1.0",
    "@aws-sdk/client-apigatewayv2": "^3.1146.0",
    "@aws-sdk/client-cloudformation": "^3.1146.0",
    "@aws-sdk/client-cloudfront": "^3.1146.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1146.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "aws-classify-server": "0.1.9",
    "js-freeze-dry": "^1.1.4"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  }
}
